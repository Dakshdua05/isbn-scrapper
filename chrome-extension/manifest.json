{
  "manifest_version": 3,
  "name": "Amazon India ISBN Finder",
  "version": "1.0.0",
  "description": "Find ISBN-13 values from Amazon India book pages opened in your browser.",
  "action": {
    "default_title": "Amazon India ISBN Finder",
    "default_popup": "popup.html"
  },
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["https://www.amazon.in/*"],
  "content_scripts": [
    {
      "matches": ["https://isbn-scrapper.vercel.app/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
